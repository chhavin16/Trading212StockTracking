# Trading 212 API credentials
# Generate at: Trading 212 App > Settings > API Key
TRADING212_API_KEY=your_api_key_here
TRADING212_API_SECRET=your_api_secret_here

# Environment: "live" or "demo"
TRADING212_ENV=live

# Finnhub API key (free)
# Get one at: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here
