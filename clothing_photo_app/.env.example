# Clothing Photo Enhancer – Environment Variables
# Copy this file to .env and fill in your real keys.
# .env is git-ignored so your secrets stay safe.

# Required: Anthropic Claude API key for clothing vision analysis
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: Replicate API token for FLUX image generation
# Get yours at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here
